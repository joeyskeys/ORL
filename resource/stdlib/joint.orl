// ORL standard joint. Users pull this in instead of a language-level joint type:
//   use joint;
//
// Host/GPU storage is orlviewer/comps/Joint: i64 parent plus 32-byte
// translation, rotation, and scale slots. Keep this field order unchanged.

struct Joint {
    int parent;
    vector translation;
    quat rotation;
    vector scale;
}

Joint joint_identity() {
    vector translation(0.0, 0.0, 0.0);
    quat rotation(0.0, 0.0, 0.0, 1.0);
    vector scale(1.0, 1.0, 1.0);
    Joint result(-1, translation, rotation, scale);
    return result;
}

Joint joint_from_trs(int parent, vector translation, quat rotation, vector scale) {
    Joint result(parent, translation, rotation, scale);
    return result;
}

matrix joint_local_matrix(Joint joint) {
    quat rotation = quat_normalize(joint.rotation);
    float x = rotation.x;
    float y = rotation.y;
    float z = rotation.z;
    float w = rotation.w;
    float xx = x * x;
    float yy = y * y;
    float zz = z * z;
    float xy = x * y;
    float xz = x * z;
    float yz = y * z;
    float wx = w * x;
    float wy = w * y;
    float wz = w * z;
    float sx = joint.scale.x;
    float sy = joint.scale.y;
    float sz = joint.scale.z;
    matrix local(
        sx * (1.0 - 2.0 * (yy + zz)), sy * (2.0 * (xy - wz)), sz * (2.0 * (xz + wy)), joint.translation.x,
        sx * (2.0 * (xy + wz)), sy * (1.0 - 2.0 * (xx + zz)), sz * (2.0 * (yz - wx)), joint.translation.y,
        sx * (2.0 * (xz - wy)), sy * (2.0 * (yz + wx)), sz * (1.0 - 2.0 * (xx + yy)), joint.translation.z,
        0.0, 0.0, 0.0, 1.0);
    return local;
}

matrix joint_world_matrix(Joint joints[], int index) {
    Joint current = joints[index];
    matrix world = joint_local_matrix(current);
    int parent = current.parent;
    while (parent >= 0) {
        current = joints[parent];
        world = mat_mul(joint_local_matrix(current), world);
        parent = current.parent;
    }
    return world;
}

matrix joint_skin_matrix(matrix world, matrix inverse_bind) {
    return mat_mul(world, inverse_bind);
}
