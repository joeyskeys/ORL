// Closest-joint auto-weight.
//   use auto_weight/closest_joint;
//
// Distance to joint world positions (points), not bone segments.
// Each vertex blends the two nearest joints with 1/d^4 weights, then
// normalizes the pair to sum to 1.

use auto_weight/common;

int auto_weight_closest_joint(point positions[],
                              Joint joints[],
                              Weight weights[],
                              int vertex_count,
                              int joint_count,
                              int weight_cnt) {
    parallel for (int vertex = 0; vertex < vertex_count; vertex = vertex + 1) {
        point p = positions[vertex];
        int best0 = -1;
        int best1 = -1;
        float d0 = 1000000000.0;
        float d1 = 1000000000.0;
        int j = 0;
        while (j < joint_count) {
            point origin = auto_weight_joint_origin(joints, j);
            float d = length(p - origin);
            if (d < d0) {
                d1 = d0;
                best1 = best0;
                d0 = d;
                best0 = j;
            } else {
                if (d < d1) {
                    d1 = d;
                    best1 = j;
                }
            }
            j = j + 1;
        }
        auto_weight_write_two_dropoff(weights, vertex, weight_cnt, best0, d0, best1, d1);
    }
    return vertex_count;
}
