// Envelope / capsule auto-weight.
//   use auto_weight/envelope;
//
// Radial capsule falloff around each bone segment, then keep the strongest
// weight_cnt influences and normalize. Typical of 3ds Max envelopes and
// Blender envelope.

use auto_weight/common;

int auto_weight_envelope(point positions[],
                         Joint joints[],
                         float radii[],
                         Weight weights[],
                         int vertex_count,
                         int joint_count,
                         int weight_cnt) {
    parallel for (int vertex = 0; vertex < vertex_count; vertex = vertex + 1) {
        point p = positions[vertex];
        int slot = 0;
        while (slot < weight_cnt) {
            int best = -1;
            float best_w = -1.0;
            int j = 0;
            while (j < joint_count) {
                int taken = auto_weight_bone_taken(weights, vertex, weight_cnt, slot, j);
                if (taken == 0) {
                    Joint joint = joints[j];
                    point child = auto_weight_joint_origin(joints, j);
                    point start = child;
                    if (joint.parent >= 0) {
                        start = auto_weight_joint_origin(joints, joint.parent);
                    }
                    float dist2 = auto_weight_segment_distance2(p, start, child);
                    float radius = radii[j];
                    vector bone = child - start;
                    float bone_len = length(bone);
                    if (radius < bone_len) {
                        radius = bone_len;
                    }
                    if (radius < 0.0001) {
                        radius = 1.0;
                    }
                    float t = 1.0 - clamp(dist2 / (radius * radius), 0.0, 1.0);
                    float w = t * t;
                    if (w > best_w) {
                        best_w = w;
                        best = j;
                    }
                }
                j = j + 1;
            }
            int out = vertex * weight_cnt + slot;
            if (best < 0) {
                weights[out] = weight_empty();
            }
            if (best >= 0) {
                if (best_w <= 0.0) {
                    weights[out] = weight_empty();
                }
                if (best_w > 0.0) {
                    weights[out] = weight_pair(best_w, best);
                }
            }
            slot = slot + 1;
        }

        float sum = 0.0;
        slot = 0;
        while (slot < weight_cnt) {
            Weight cell = weights[vertex * weight_cnt + slot];
            sum = sum + cell.weight;
            slot = slot + 1;
        }
        if (sum > 0.0000001) {
            slot = 0;
            while (slot < weight_cnt) {
                int out = vertex * weight_cnt + slot;
                Weight cell = weights[out];
                cell.weight = cell.weight / sum;
                weights[out] = cell;
                slot = slot + 1;
            }
        }
        if (sum <= 0.0000001) {
            auto_weight_write_hard(weights, vertex, 0, weight_cnt);
        }
    }
    return vertex_count;
}
