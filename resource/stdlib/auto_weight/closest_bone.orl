// Closest bone-segment auto-weight.
//   use auto_weight/closest_bone;
//
// Each non-root joint is a segment from its parent world position to its own.
// Root joints are points. Each vertex blends the two nearest bones with
// 1/d^4 weights, then normalizes the pair to sum to 1.

use auto_weight/common;

float closest_bone_segment_distance2(point p, point a, point b) {
    return auto_weight_segment_distance2(p, a, b);
}

int auto_weight_closest_bone(point positions[],
                             Joint joints[],
                             Weight weights[],
                             int vertex_count,
                             int joint_count,
                             int weight_cnt) {
    parallel for (int vertex = 0; vertex < vertex_count; vertex = vertex + 1) {
        point p = positions[vertex];
        int best0 = -1;
        int best1 = -1;
        float d0 = 1000000000.0;
        float d1 = 1000000000.0;
        int j = 0;
        while (j < joint_count) {
            float d = auto_weight_joint_bone_distance(p, joints, j);
            if (d < d0) {
                d1 = d0;
                best1 = best0;
                d0 = d;
                best0 = j;
            } else {
                if (d < d1) {
                    d1 = d;
                    best1 = j;
                }
            }
            j = j + 1;
        }
        auto_weight_write_two_dropoff(weights, vertex, weight_cnt, best0, d0, best1, d1);
    }
    return vertex_count;
}
