// Bounded biharmonic weights (Jacobson et al.).
//   use auto_weight/bounded_biharmonic;
//
// Harmonic solve plus per-iteration projection onto 0..1 and partition of
// unity. Not a full QP biharmonic energy; that needs a denser Hessian.

use auto_weight/common;

int auto_weight_bbw_pin(float d0, float d1, float radius2) {
    int pin = 0;
    if (d0 < radius2 * 0.85) {
        pin = 1;
    }
    if (d0 * 1.15 < d1) {
        pin = 1;
    }
    return pin;
}

int auto_weight_bounded_biharmonic(point positions[],
                                   int offsets[],
                                   int neighbors[],
                                   Joint joints[],
                                   float radii[],
                                   float scratch[],
                                   Weight weights[],
                                   int vertex_count,
                                   int joint_count,
                                   int weight_cnt) {
    int v = 0;
    while (v < vertex_count) {
        point p = positions[v];
        int closest = 0;
        float d0 = 1.0e30;
        float d1 = 1.0e30;
        int j = 0;
        while (j < joint_count) {
            Joint joint = joints[j];
            point child = auto_weight_joint_origin(joints, j);
            point start = child;
            if (joint.parent >= 0) {
                start = auto_weight_joint_origin(joints, joint.parent);
            }
            float dist = auto_weight_segment_distance2(p, start, child);
            if (dist < d0) {
                d1 = d0;
                d0 = dist;
                closest = j;
            }
            if (dist >= d0) {
                if (j != closest) {
                    if (dist < d1) {
                        d1 = dist;
                    }
                }
            }
            j = j + 1;
        }

        float radius = radii[closest];
        if (radius < 0.0001) {
            radius = 1.0;
        }
        int pinned = auto_weight_bbw_pin(d0, d1, radius * radius);
        j = 0;
        while (j < joint_count) {
            float value = 0.0;
            if (pinned != 0) {
                if (j == closest) {
                    value = 1.0;
                }
            }
            scratch[v * joint_count + j] = value;
            j = j + 1;
        }
        if (pinned != 0) {
            weights[v * weight_cnt] = weight_pair(0.0, closest);
        }
        if (pinned == 0) {
            weights[v * weight_cnt] = weight_empty();
        }
        v = v + 1;
    }

    int iter = 0;
    while (iter < 24) {
        v = 0;
        while (v < vertex_count) {
            Weight pin = weights[v * weight_cnt];
            if (pin.joint < 0) {
                int begin = offsets[v];
                int end = offsets[v + 1];
                float deg = 0.0;
                int e = begin;
                while (e < end) {
                    deg = deg + 1.0;
                    e = e + 1;
                }
                if (deg > 0.0) {
                    int j = 0;
                    float sum = 0.0;
                    while (j < joint_count) {
                        float acc = 0.0;
                        e = begin;
                        while (e < end) {
                            int n = neighbors[e];
                            acc = acc + scratch[n * joint_count + j];
                            e = e + 1;
                        }
                        float value = acc / deg;
                        if (value < 0.0) {
                            value = 0.0;
                        }
                        if (value > 1.0) {
                            value = 1.0;
                        }
                        scratch[v * joint_count + j] = value;
                        sum = sum + value;
                        j = j + 1;
                    }
                    if (sum > 0.0000001) {
                        j = 0;
                        while (j < joint_count) {
                            int slot = v * joint_count + j;
                            scratch[slot] = scratch[slot] / sum;
                            j = j + 1;
                        }
                    }
                }
            }
            v = v + 1;
        }
        iter = iter + 1;
    }

    parallel for (int vertex = 0; vertex < vertex_count; vertex = vertex + 1) {
        auto_weight_write_topk(scratch, weights, vertex, joint_count, weight_cnt);
    }
    return vertex_count;
}
