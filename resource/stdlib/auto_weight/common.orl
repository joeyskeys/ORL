// Shared auto-weight helpers.
//   use auto_weight/common;

use joint;
use weight;

float auto_weight_segment_distance2(point p, point a, point b) {
    vector ab = b - a;
    vector ap = p - a;
    float ab2 = dot(ab, ab);
    float t = 0.0;
    if (ab2 > 0.0000001) {
        t = clamp(dot(ap, ab) / ab2, 0.0, 1.0);
    }
    point closest = a + t * ab;
    vector delta = p - closest;
    return dot(delta, delta);
}

float auto_weight_segment_distance(point p, point a, point b) {
    vector ab = b - a;
    vector ap = p - a;
    float ab2 = dot(ab, ab);
    float t = 0.0;
    if (ab2 > 0.0000001) {
        t = clamp(dot(ap, ab) / ab2, 0.0, 1.0);
    }
    point closest = a + t * ab;
    return length(p - closest);
}

point auto_weight_joint_origin(Joint joints[], int index) {
    matrix world = joint_world_matrix(joints, index);
    return world * point(0.0, 0.0, 0.0);
}

int auto_weight_bone_taken(Weight weights[], int vertex, int weight_cnt, int slot, int bone) {
    int s = 0;
    while (s < slot) {
        Weight cell = weights[vertex * weight_cnt + s];
        if (cell.joint == bone) {
            return 1;
        }
        s = s + 1;
    }
    return 0;
}

int auto_weight_write_hard(Weight weights[], int vertex, int bone, int weight_cnt) {
    weights[vertex * weight_cnt] = weight_bind(bone);
    int slot = 1;
    while (slot < weight_cnt) {
        weights[vertex * weight_cnt + slot] = weight_empty();
        slot = slot + 1;
    }
    return weight_cnt;
}

int auto_weight_write_topk(float scratch[],
                           Weight weights[],
                           int vertex,
                           int joint_count,
                           int weight_cnt) {
    int slot = 0;
    while (slot < weight_cnt) {
        int best = -1;
        float best_w = -1.0;
        int j = 0;
        while (j < joint_count) {
            float w = scratch[vertex * joint_count + j];
            int taken = auto_weight_bone_taken(weights, vertex, weight_cnt, slot, j);
            if (taken == 0) {
                if (w > best_w) {
                    best_w = w;
                    best = j;
                }
            }
            j = j + 1;
        }
        int out = vertex * weight_cnt + slot;
        if (best < 0) {
            weights[out] = weight_empty();
        }
        if (best >= 0) {
            if (best_w <= 0.0) {
                weights[out] = weight_empty();
            }
            if (best_w > 0.0) {
                weights[out] = weight_pair(best_w, best);
            }
        }
        slot = slot + 1;
    }

    float sum = 0.0;
    slot = 0;
    while (slot < weight_cnt) {
        Weight cell = weights[vertex * weight_cnt + slot];
        sum = sum + cell.weight;
        slot = slot + 1;
    }
    if (sum > 0.0000001) {
        slot = 0;
        while (slot < weight_cnt) {
            int out = vertex * weight_cnt + slot;
            Weight cell = weights[out];
            cell.weight = cell.weight / sum;
            weights[out] = cell;
            slot = slot + 1;
        }
        return weight_cnt;
    }

    int fallback = 0;
    float best_w = scratch[vertex * joint_count];
    int j = 1;
    while (j < joint_count) {
        float w = scratch[vertex * joint_count + j];
        if (w > best_w) {
            best_w = w;
            fallback = j;
        }
        j = j + 1;
    }
    auto_weight_write_hard(weights, vertex, fallback, weight_cnt);
    return weight_cnt;
}
