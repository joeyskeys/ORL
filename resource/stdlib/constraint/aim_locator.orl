// Locator-target aim constraint.
//   use constraint/aim_locator;
//
// Rotates each subject so its local aim axis points at the selected Locator.
// The subject translation and scale are preserved.

use locator;
use constraint/common;

export int constraint_aim_locator [[ string stage = "solver" ]]
    (Locator targets[],
    matrix subjects[],
    vector axes[],
    int target_index,
    int subject_index,
    int target_count,
    int subject_count) {
    if (target_index < 0 || target_index >= target_count) {
        return 0;
    }
    if (subject_index < 0 || subject_index >= subject_count) {
        return 0;
    }
    point target_position = targets[target_index].xform
        * point(0.0, 0.0, 0.0);
    matrix result = constraint_common_aim_value(
        subjects[subject_index], target_position, axes[0]);
    subjects[subject_index] = result;
    return 1;
}
