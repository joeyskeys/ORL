// Locator-target aim constraint.
//   use constraint/aim_locator;
//
// Rotates each subject so its local aim axis points at the selected Locator.
// The subject translation and scale are preserved.

use locator;
use constraint/common;
use constraint/handles;

export int constraint_aim_locator [[
    string stage = "solver",
    string partial_propagation = "none"
]]
    (locator_handle target,
     destination_xform_handle subject,
     vector axes[]) {
    Locator target_data = Locator(target);
    point target_position = target_data.xform
        * point(0.0, 0.0, 0.0);
    matrix result = constraint_common_aim_value(
        constraint_handle_read(subject), target_position, axes[0]);
    return constraint_handle_write(subject, result);
}
