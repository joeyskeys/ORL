// Copy-translation constraint.
//   use constraint/copy_translation;
//
// Copies only the source translation and preserves destination rotation/scale.

use constraint/common;
use constraint/handles;

export int constraint_copy_translation [[
    string stage = "solver",
    string partial_propagation = "none"
]]
    (source_xform_handle source, destination_xform_handle destination) {
    matrix result = constraint_common_copy_translation_value(
        constraint_handle_read(source),
        constraint_handle_read(destination));
    return constraint_handle_write(destination, result);
}
