// Copy-rotation constraint.
//   use constraint/copy_rotation;
//
// Copies the source orientation while preserving the destination translation
// and positive axis scales.

use constraint/common;

export int constraint_copy_rotation [[
    string stage = "solver",
    string partial_propagation = "none",
    string partial_read_joint_ports = "source_index",
    string partial_read_controller_ports = "source_index",
    string partial_read_locator_ports = "source_index",
    string partial_write_joint_ports = "destination_index",
    string partial_write_controller_ports = "destination_index",
    string partial_write_locator_ports = "destination_index"
]]
    (matrix source[],
                             matrix destination[],
                             int source_index,
                             int destination_index,
                             int source_count,
                             int destination_count) {
    if (source_index < 0 || source_index >= source_count) {
        return 0;
    }
    if (destination_index < 0 || destination_index >= destination_count) {
        return 0;
    }
    matrix result = constraint_common_copy_rotation_value(
        source[source_index], destination[destination_index]);
    destination[destination_index] = result;
    return 1;
}
