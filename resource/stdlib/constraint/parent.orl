// Parent constraint.
//   use constraint/parent;
//
// Keeps the destination's distance and orientation relative to the source.
// The source and destination are exact-specialized transform handles.

use constraint/handles;

export int constraint_parent [[
    string stage = "solver",
    string partial_propagation = "none"
]]
    (source_xform_handle source,
     destination_xform_handle destination,
     matrix offset) {
    matrix result = mat_mul(constraint_handle_read(source), offset);
    return constraint_handle_write(destination, result);
}
