// Aim constraint.
//   use constraint/aim;
//
// Rotates a subject transform so its local aim axis points at the origin of
// a target transform. The subject translation and axis scales are preserved.
// axes[] is a one-element vector buffer containing the local aim axis.

use constraint/common;
use constraint/handles;

export int constraint_aim [[
    string stage = "solver",
    string partial_propagation = "none"
]]
    (source_xform_handle target,
     destination_xform_handle subject,
     vector axes[]) {
    matrix target_data = constraint_handle_read(target);
    point target_position(target_data[3], target_data[7], target_data[11]);
    matrix result = constraint_common_aim_value(
        constraint_handle_read(subject), target_position, axes[0]);
    return constraint_handle_write(subject, result);
}
