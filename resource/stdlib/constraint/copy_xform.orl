// Copy-transform constraint.
//   use constraint/copy_xform;
//
// Copies one complete source transform into one destination transform.
// Source and destination may be different matrix buffers.

use constraint/handles;

export int constraint_copy_xform [[
    string stage = "solver",
    string partial_propagation = "none"
]]
    (source_xform_handle source, destination_xform_handle destination) {
    return constraint_handle_write(
        destination, constraint_handle_read(source));
}
