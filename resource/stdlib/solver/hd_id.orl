// History-dependent inverse kinematics.
//   use solver/hd_id;
//
// Uses typed root/end/target handles for a bounded CCD walk. The history
// buffer remains an explicit state socket for future handle-based warm starts.

use rig/handles;
use joint;
use locator;

vector solver_hd_id_any_perpendicular(vector axis) {
    vector up(0.0, 1.0, 0.0);
    vector side = cross(axis, up);
    if (length(side) < 0.000001) {
        vector right(1.0, 0.0, 0.0);
        side = cross(axis, right);
    }
    return normalize(side);
}

quat solver_hd_id_from_to(vector from, vector to) {
    if (length(from) < 0.000001 || length(to) < 0.000001) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }

    vector f = normalize(from);
    vector t = normalize(to);
    float d = dot(f, t);
    if (d > 0.999999) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }
    if (d < -0.999999) {
        vector axis = solver_hd_id_any_perpendicular(f);
        quat half(axis.x, axis.y, axis.z, 0.0);
        return quat_normalize(half);
    }
    vector c = cross(f, t);
    quat q(c.x, c.y, c.z, 1.0 + d);
    return quat_normalize(q);
}

point solver_hd_id_joint_origin(joint_handle value) {
    WorldTransform world_data = WorldTransform(value);
    return world_data.xform * point(0.0, 0.0, 0.0);
}

matrix solver_hd_id_local_matrix(joint_handle value) {
    Joint joint_data = Joint(value);
    quat rotation = quat_normalize(joint_data.rotation);
    float x = rotation.x;
    float y = rotation.y;
    float z = rotation.z;
    float w = rotation.w;
    float xx = x * x;
    float yy = y * y;
    float zz = z * z;
    float xy = x * y;
    float xz = x * z;
    float yz = y * z;
    float wx = w * x;
    float wy = w * y;
    float wz = w * z;
    float sx = joint_data.scale.x;
    float sy = joint_data.scale.y;
    float sz = joint_data.scale.z;
    return matrix(
        sx * (1.0 - 2.0 * (yy + zz)),
        sy * (2.0 * (xy - wz)),
        sz * (2.0 * (xz + wy)),
        joint_data.translation.x,
        sx * (2.0 * (xy + wz)),
        sy * (1.0 - 2.0 * (xx + zz)),
        sz * (2.0 * (yz - wx)),
        joint_data.translation.y,
        sx * (2.0 * (xz - wy)),
        sy * (2.0 * (yz + wx)),
        sz * (1.0 - 2.0 * (xx + yy)),
        joint_data.translation.z,
        0.0, 0.0, 0.0, 1.0);
}

matrix solver_hd_id_parent_world(joint_handle value) {
    joint_handle parent = joint_parent(value);
    if (!handle_valid(parent)) {
        return mat_identity();
    }
    WorldTransform world_data = WorldTransform(value);
    return mat_mul(
        world_data.xform,
        mat_inverse(solver_hd_id_local_matrix(value)));
}

point solver_hd_id_parent_local(joint_handle value, point world) {
    return mat_inverse(solver_hd_id_parent_world(value)) * world;
}

export int solver_hd_id [[
    string stage = "solver",
    int stateful = 1,
    string partial_propagation = "descendants"
]]
    (Joint history[],
     joint_handle root,
     joint_handle end,
     locator_handle target,
     int iterations) {
    if (!handle_valid(root) || !handle_valid(end)
        || !handle_valid(target)
        || joint_is_ancestor(root, end) == 0)
    {
        return 0;
    }
    if (iterations < 1) {
        iterations = 1;
    }

    Locator target_data = Locator(target);
    point target_pos = target_data.xform
        * point(0.0, 0.0, 0.0);
    int pass = 0;
    while (pass < iterations) {
        joint_handle pivot = joint_parent(end);
        int depth = 0;
        while (handle_valid(pivot)
            && depth < solver_context.joint_count)
        {
            point end_pos = solver_hd_id_joint_origin(end);
            point pivot_pos = solver_hd_id_joint_origin(pivot);
            vector current_world = end_pos - pivot_pos;
            vector desired_world = target_pos - pivot_pos;
            if (length(current_world) > 0.000001
                && length(desired_world) > 0.000001)
            {
                joint_handle parent = joint_parent(pivot);
                point current_local = end_pos;
                point pivot_local = pivot_pos;
                point target_local = target_pos;
                if (handle_valid(parent)) {
                    matrix parent_inverse =
                        mat_inverse(solver_hd_id_parent_world(pivot));
                    current_local = parent_inverse * end_pos;
                    pivot_local = parent_inverse * pivot_pos;
                    target_local = parent_inverse * target_pos;
                }
                vector current_local_direction =
                    current_local - pivot_local;
                vector desired_local_direction =
                    target_local - pivot_local;
                quat delta = solver_hd_id_from_to(
                    current_local_direction,
                    desired_local_direction);
                Joint solved = Joint(pivot);
                solved.rotation = quat_normalize(
                    quat_mul(delta, solved.rotation));
            }
            if (pivot == root) {
                pivot = joint_handle_invalid();
            } else {
                pivot = joint_parent(pivot);
            }
            depth = depth + 1;
        }
        pass = pass + 1;
    }
    return 1;
}
