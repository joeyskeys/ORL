// Full-body inverse kinematics.
//   use solver/full_body_ik;
//
// effectors[] and targets[] carry multiple typed end-effector and locator
// handles.
// The solver performs sequential CCD over every ancestor of each
// effector for the requested number of passes. It updates local rotations
// while preserving translations, hierarchy, and scale.

use rig/handles;
use joint;
use locator;

vector solver_full_body_ik_any_perpendicular(vector axis) {
    vector up(0.0, 1.0, 0.0);
    vector side = cross(axis, up);
    if (length(side) < 0.000001) {
        vector right(1.0, 0.0, 0.0);
        side = cross(axis, right);
    }
    return normalize(side);
}

quat solver_full_body_ik_quat_from_to(vector from, vector to) {
    if (length(from) < 0.000001 || length(to) < 0.000001) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }

    vector f = normalize(from);
    vector t = normalize(to);
    float d = dot(f, t);
    if (d > 0.999999) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }
    if (d < -0.999999) {
        vector axis = solver_full_body_ik_any_perpendicular(f);
        quat half(axis.x, axis.y, axis.z, 0.0);
        return quat_normalize(half);
    }
    vector c = cross(f, t);
    quat q(c.x, c.y, c.z, 1.0 + d);
    return quat_normalize(q);
}

point solver_full_body_ik_joint_origin(joint_handle value) {
    WorldTransform world_data = WorldTransform(value);
    return world_data.xform * point(0.0, 0.0, 0.0);
}

matrix solver_full_body_ik_local_matrix(joint_handle value) {
    Joint joint_data = Joint(value);
    quat rotation = quat_normalize(joint_data.rotation);
    float x = rotation.x;
    float y = rotation.y;
    float z = rotation.z;
    float w = rotation.w;
    float xx = x * x;
    float yy = y * y;
    float zz = z * z;
    float xy = x * y;
    float xz = x * z;
    float yz = y * z;
    float wx = w * x;
    float wy = w * y;
    float wz = w * z;
    float sx = joint_data.scale.x;
    float sy = joint_data.scale.y;
    float sz = joint_data.scale.z;
    return matrix(
        sx * (1.0 - 2.0 * (yy + zz)),
        sy * (2.0 * (xy - wz)),
        sz * (2.0 * (xz + wy)),
        joint_data.translation.x,
        sx * (2.0 * (xy + wz)),
        sy * (1.0 - 2.0 * (xx + zz)),
        sz * (2.0 * (yz - wx)),
        joint_data.translation.y,
        sx * (2.0 * (xz - wy)),
        sy * (2.0 * (yz + wx)),
        sz * (1.0 - 2.0 * (xx + yy)),
        joint_data.translation.z,
        0.0, 0.0, 0.0, 1.0);
}

matrix solver_full_body_ik_parent_world(joint_handle value) {
    joint_handle parent = joint_parent(value);
    if (!handle_valid(parent)) {
        return mat_identity();
    }
    WorldTransform world_data = WorldTransform(value);
    return mat_mul(
        world_data.xform,
        mat_inverse(solver_full_body_ik_local_matrix(value)));
}

export int solver_full_body_ik [[
    string stage = "solver",
    string partial_propagation = "descendants"
]]
    (joint_handle effectors[],
     locator_handle targets[],
     int effector_count,
     int iterations) {
    int joint_count = solver_context.joint_count;
    if (effector_count < 1 || joint_count < 1
        || iterations < 1)
    {
        return 0;
    }

    int effector = 0;
    while (effector < effector_count) {
        if (!handle_valid(effectors[effector])
            || !handle_valid(targets[effector]))
        {
            return 0;
        }
        effector = effector + 1;
    }

    int pass = 0;
    while (pass < iterations) {
        effector = 0;
        while (effector < effector_count) {
            joint_handle end = effectors[effector];
            Locator target_data = Locator(targets[effector]);
            point target = target_data.xform
                * point(0.0, 0.0, 0.0);
            joint_handle pivot = joint_parent(end);
            int depth = 0;
            while (handle_valid(pivot) && depth < joint_count) {
                point end_position =
                    solver_full_body_ik_joint_origin(end);
                point pivot_position =
                    solver_full_body_ik_joint_origin(pivot);
                vector current_world = end_position - pivot_position;
                vector desired_world = target - pivot_position;

                if (length(current_world) > 0.000001
                    && length(desired_world) > 0.000001)
                {
                    joint_handle parent = joint_parent(pivot);
                    point current_local = end_position;
                    point pivot_local = pivot_position;
                    point target_local = target;
                    if (handle_valid(parent)) {
                        matrix parent_inverse =
                            mat_inverse(
                                solver_full_body_ik_parent_world(pivot));
                        current_local = parent_inverse * end_position;
                        pivot_local = parent_inverse * pivot_position;
                        target_local = parent_inverse * target;
                    }
                    vector current_local_direction =
                        current_local - pivot_local;
                    vector desired_local_direction =
                        target_local - pivot_local;
                    quat delta =
                        solver_full_body_ik_quat_from_to(
                            current_local_direction,
                            desired_local_direction);
                    Joint solved = Joint(pivot);
                    solved.rotation = quat_normalize(
                        quat_mul(delta, solved.rotation));
                }

                pivot = joint_parent(pivot);
                depth = depth + 1;
            }
            effector = effector + 1;
        }
        pass = pass + 1;
    }
    return effector_count;
}
