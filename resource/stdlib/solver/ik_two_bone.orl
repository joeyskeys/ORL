// Analytic two-bone IK.
//   use solver/ik_two_bone;
//
// Rotates root and mid so the end reaches target. pole aims the bend.
// target_index and pole_index select Locator values from solver_context;
// the end joint is left alone.

use joint;
use locator;

float solver_abs(float x) {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

float solver_sqrt(float x) {
    if (x <= 0.0) {
        return 0.0;
    }
    float g = x;
    if (g < 1.0) {
        g = 1.0;
    }
    int i = 0;
    while (i < 8) {
        g = 0.5 * (g + x / g);
        i = i + 1;
    }
    return g;
}

vector solver_joint_offset(Joint joint) {
    vector offset(joint.translation.x, joint.translation.y, joint.translation.z);
    return offset;
}

point solver_joint_origin(int index) {
    matrix world = joint_world_matrix(solver_context.joints, index);
    return world * point(0.0, 0.0, 0.0);
}

point solver_world_to_local(int parent, point world) {
    if (parent < 0) {
        return world;
    }
    matrix inv = mat_inverse(
        joint_world_matrix(solver_context.joints, parent));
    return inv * world;
}

vector solver_any_perpendicular(vector axis) {
    // Use a wide, deterministic reference-vector split. Choosing the
    // fallback only at an almost-zero cross product makes the selected
    // bend plane very sensitive to small floating-point changes.
    vector reference(0.0, 1.0, 0.0);
    if (solver_abs(axis.y) > 0.9) {
        reference = vector(1.0, 0.0, 0.0);
    }
    vector side = cross(axis, reference);
    return normalize(side);
}

quat solver_quat_from_to(vector from, vector to) {
    if (length(from) < 0.000001) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }
    if (length(to) < 0.000001) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }
    vector f = normalize(from);
    vector t = normalize(to);
    float d = dot(f, t);
    if (d > 0.999999) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }
    if (d < -0.999999) {
        vector axis = solver_any_perpendicular(f);
        quat half(axis.x, axis.y, axis.z, 0.0);
        return quat_normalize(half);
    }
    vector c = cross(f, t);
    quat q(c.x, c.y, c.z, 1.0 + d);
    return quat_normalize(q);
}

export int solver_ik_two_bone [[
    string stage = "solver",
    string partial_propagation = "descendants",
    string partial_read_joint_ports = "root,mid,end",
    string partial_write_joint_ports = "root,mid",
    string partial_read_locator_ports = "target_index,pole_index"
]]
    (int root,
                       int mid,
                       int end,
                       int target_index,
                       int pole_index) {
    int joint_count = solver_context.joint_count;
    int locator_count = solver_context.locator_count;
    if (root < 0) {
        return 0;
    }
    if (mid < 0) {
        return 0;
    }
    if (end < 0) {
        return 0;
    }
    if (root >= joint_count) {
        return 0;
    }
    if (mid >= joint_count) {
        return 0;
    }
    if (end >= joint_count) {
        return 0;
    }
    if (target_index < 0 || target_index >= locator_count) {
        return 0;
    }
    if (pole_index < 0 || pole_index >= locator_count) {
        return 0;
    }

    Joint root_joint = solver_context.joints[root];
    Joint mid_joint = solver_context.joints[mid];
    Joint end_joint = solver_context.joints[end];
    if (mid_joint.parent != root) {
        return 0;
    }
    if (end_joint.parent != mid) {
        return 0;
    }

    vector upper = solver_joint_offset(mid_joint);
    vector lower = solver_joint_offset(end_joint);
    float L1 = length(upper);
    float L2 = length(lower);
    if (L1 < 0.000001) {
        return 0;
    }
    if (L2 < 0.000001) {
        return 0;
    }

    point root_pos = solver_joint_origin(root);
    point target_pos = solver_context.locators[target_index].xform
        * point(0.0, 0.0, 0.0);
    vector reach = target_pos - root_pos;
    float d = length(reach);
    if (d < 0.000001) {
        return 0;
    }

    float max_reach = L1 + L2;
    float min_reach = solver_abs(L1 - L2);
    float d_clamped = clamp(d, min_reach, max_reach);
    if (d_clamped < 0.000001) {
        return 0;
    }

    vector axis = normalize(reach);
    point pole_pos = solver_context.locators[pole_index].xform
        * point(0.0, 0.0, 0.0);

    vector pole_dir = pole_pos - root_pos;
    vector side = pole_dir - axis * dot(pole_dir, axis);
    // A pole on (or very close to) the reach axis does not define a bend
    // plane. Reusing the current elbow direction avoids switching between
    // arbitrary perpendicular branches from one frame to the next.
    if (length(side) < 0.0001) {
        point current_mid = solver_joint_origin(mid);
        vector current_dir = current_mid - root_pos;
        vector current_side =
            current_dir - axis * dot(current_dir, axis);
        if (length(current_side) >= 0.0001) {
            side = current_side;
        } else {
            side = solver_any_perpendicular(axis);
        }
    }
    side = normalize(side);

    float x = (d_clamped * d_clamped + L1 * L1 - L2 * L2) / (2.0 * d_clamped);
    float h2 = L1 * L1 - x * x;
    if (h2 < 0.0) {
        h2 = 0.0;
    }
    float h = solver_sqrt(h2);
    point elbow = root_pos + axis * x + side * h;
    point reach_target = root_pos + axis * d_clamped;

    point elbow_local = solver_world_to_local(root_joint.parent, elbow);
    vector root_offset = solver_joint_offset(root_joint);
    vector desired_root = elbow_local - root_offset;
    root_joint.rotation = solver_quat_from_to(upper, desired_root);
    solver_context.joints[root] = root_joint;

    point target_local = solver_world_to_local(root, reach_target);
    vector desired_mid = target_local - upper;
    mid_joint.rotation = solver_quat_from_to(lower, desired_mid);
    solver_context.joints[mid] = mid_joint;
    return 1;
}
