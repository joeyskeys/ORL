// Analytic two-bone IK.
//   use solver/ik_two_bone;
//
// Rotates root and mid so the end reaches target. pole aims the bend.
// All component selection is carried by exact typed handles; the end joint is
// left alone.

use rig/handles;
use joint;
use locator;

float solver_abs(float x) {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

float solver_sqrt(float x) {
    if (x <= 0.0) {
        return 0.0;
    }
    float g = x;
    if (g < 1.0) {
        g = 1.0;
    }
    int i = 0;
    while (i < 8) {
        g = 0.5 * (g + x / g);
        i = i + 1;
    }
    return g;
}

vector solver_joint_offset(joint_handle value) {
    Joint joint_data = Joint(value);
    vector offset(joint_data.translation.x,
        joint_data.translation.y, joint_data.translation.z);
    return offset;
}

point solver_joint_origin(joint_handle value) {
    WorldTransform world_data = WorldTransform(value);
    return world_data.xform * point(0.0, 0.0, 0.0);
}

matrix solver_local_matrix(joint_handle value) {
    Joint joint_data = Joint(value);
    quat rotation = quat_normalize(joint_data.rotation);
    float x = rotation.x;
    float y = rotation.y;
    float z = rotation.z;
    float w = rotation.w;
    float xx = x * x;
    float yy = y * y;
    float zz = z * z;
    float xy = x * y;
    float xz = x * z;
    float yz = y * z;
    float wx = w * x;
    float wy = w * y;
    float wz = w * z;
    float sx = joint_data.scale.x;
    float sy = joint_data.scale.y;
    float sz = joint_data.scale.z;
    return matrix(
        sx * (1.0 - 2.0 * (yy + zz)),
        sy * (2.0 * (xy - wz)),
        sz * (2.0 * (xz + wy)),
        joint_data.translation.x,
        sx * (2.0 * (xy + wz)),
        sy * (1.0 - 2.0 * (xx + zz)),
        sz * (2.0 * (yz - wx)),
        joint_data.translation.y,
        sx * (2.0 * (xz - wy)),
        sy * (2.0 * (yz + wx)),
        sz * (1.0 - 2.0 * (xx + yy)),
        joint_data.translation.z,
        0.0, 0.0, 0.0, 1.0);
}

matrix solver_parent_world(joint_handle value) {
    Joint joint_data = Joint(value);
    WorldTransform world_data = WorldTransform(value);
    if (joint_data.parent < 0) {
        return mat_identity();
    }
    return mat_mul(
        world_data.xform,
        mat_inverse(solver_local_matrix(value)));
}

point solver_world_to_parent_local(joint_handle value, point world) {
    return mat_inverse(solver_parent_world(value)) * world;
}

point solver_world_to_joint_local(joint_handle value, point world) {
    WorldTransform world_data = WorldTransform(value);
    return mat_inverse(world_data.xform) * world;
}

vector solver_any_perpendicular(vector axis) {
    // Use a wide, deterministic reference-vector split. Choosing the
    // fallback only at an almost-zero cross product makes the selected
    // bend plane very sensitive to small floating-point changes.
    vector reference(0.0, 1.0, 0.0);
    if (solver_abs(axis.y) > 0.9) {
        reference = vector(1.0, 0.0, 0.0);
    }
    vector side = cross(axis, reference);
    return normalize(side);
}

quat solver_quat_from_to(vector from, vector to) {
    if (length(from) < 0.000001) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }
    if (length(to) < 0.000001) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }
    vector f = normalize(from);
    vector t = normalize(to);
    float d = dot(f, t);
    if (d > 0.999999) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }
    if (d < -0.999999) {
        vector axis = solver_any_perpendicular(f);
        quat half(axis.x, axis.y, axis.z, 0.0);
        return quat_normalize(half);
    }
    vector c = cross(f, t);
    quat q(c.x, c.y, c.z, 1.0 + d);
    return quat_normalize(q);
}

export int solver_ik_two_bone [[
    string stage = "solver",
    string partial_propagation = "descendants"
]]
    (joint_handle root,
     joint_handle mid,
     joint_handle end,
     locator_handle target,
     locator_handle pole) {
    Joint root_joint = Joint(root);
    Joint mid_joint = Joint(mid);
    Locator target_data = Locator(target);
    Locator pole_data = Locator(pole);

    vector upper = solver_joint_offset(mid);
    vector lower = solver_joint_offset(end);
    float L1 = length(upper);
    float L2 = length(lower);
    if (L1 < 0.000001) {
        return 0;
    }
    if (L2 < 0.000001) {
        return 0;
    }

    point root_pos = solver_joint_origin(root);
    point target_pos = target_data.xform
        * point(0.0, 0.0, 0.0);
    vector reach = target_pos - root_pos;
    float d = length(reach);
    if (d < 0.000001) {
        return 0;
    }

    float max_reach = L1 + L2;
    float min_reach = solver_abs(L1 - L2);
    float d_clamped = clamp(d, min_reach, max_reach);
    if (d_clamped < 0.000001) {
        return 0;
    }

    vector axis = normalize(reach);
    point pole_pos = pole_data.xform
        * point(0.0, 0.0, 0.0);

    vector pole_dir = pole_pos - root_pos;
    vector side = pole_dir - axis * dot(pole_dir, axis);
    // A pole on (or very close to) the reach axis does not define a bend
    // plane. Reusing the current elbow direction avoids switching between
    // arbitrary perpendicular branches from one frame to the next.
    if (length(side) < 0.0001) {
        point current_mid = solver_joint_origin(mid);
        vector current_dir = current_mid - root_pos;
        vector current_side =
            current_dir - axis * dot(current_dir, axis);
        if (length(current_side) >= 0.0001) {
            side = current_side;
        } else {
            side = solver_any_perpendicular(axis);
        }
    }
    side = normalize(side);

    float x = (d_clamped * d_clamped + L1 * L1 - L2 * L2) / (2.0 * d_clamped);
    float h2 = L1 * L1 - x * x;
    if (h2 < 0.0) {
        h2 = 0.0;
    }
    float h = solver_sqrt(h2);
    point elbow = root_pos + axis * x + side * h;
    point reach_target = root_pos + axis * d_clamped;

    point elbow_local = solver_world_to_parent_local(root, elbow);
    vector root_offset = solver_joint_offset(root);
    vector desired_root = elbow_local - root_offset;
    root_joint.rotation = solver_quat_from_to(upper, desired_root);

    point target_local = solver_world_to_joint_local(root, reach_target);
    vector desired_mid = target_local - upper;
    mid_joint.rotation = solver_quat_from_to(lower, desired_mid);
    return 1;
}
