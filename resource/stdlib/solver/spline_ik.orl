// Spline inverse kinematics.
//   use solver/spline_ik;
//
// root/end handles define a contiguous joint path. spline[] contains
// world-space Catmull-Rom control points. The solver preserves local
// translations and rotates each path segment to follow the spline tangent.

use rig/handles;
use joint;

point solver_spline_ik_catmull(point p0, point p1, point p2, point p3, float t) {
    float t2 = t * t;
    float t3 = t2 * t;
    float h1 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h2 = t3 - 2.0 * t2 + t;
    float h3 = -2.0 * t3 + 3.0 * t2;
    float h4 = t3 - t2;
    vector m1 = 0.5 * (p2 - p0);
    vector m2 = 0.5 * (p3 - p1);
    return h1 * p1 + h2 * m1 + h3 * p2 + h4 * m2;
}

point solver_spline_ik_sample(point spline[], int point_count, float t) {
    if (point_count <= 0) {
        return point(0.0, 0.0, 0.0);
    }
    if (point_count == 1) {
        return spline[0];
    }

    float clamped = clamp(t, 0.0, 1.0);
    float scaled = clamped * (point_count - 1);
    int segment = scaled;
    float local = scaled - segment;
    if (segment >= point_count - 1) {
        segment = point_count - 2;
        local = 1.0;
    }

    int p0_index = segment - 1;
    int p1_index = segment;
    int p2_index = segment + 1;
    int p3_index = segment + 2;
    if (p0_index < 0) {
        p0_index = 0;
    }
    if (p3_index >= point_count) {
        p3_index = point_count - 1;
    }
    return solver_spline_ik_catmull(
        spline[p0_index], spline[p1_index], spline[p2_index], spline[p3_index], local);
}

quat solver_spline_ik_quat_from_to(vector from, vector to) {
    if (length(from) < 0.000001 || length(to) < 0.000001) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }
    vector f = normalize(from);
    vector t = normalize(to);
    float d = dot(f, t);
    if (d > 0.999999) {
        quat identity(0.0, 0.0, 0.0, 1.0);
        return identity;
    }
    if (d < -0.999999) {
        vector axis = vector(0.0, 1.0, 0.0);
        if (length(cross(f, axis)) < 0.000001) {
            axis = vector(1.0, 0.0, 0.0);
        }
        axis = normalize(cross(f, axis));
        quat half(axis.x, axis.y, axis.z, 0.0);
        return quat_normalize(half);
    }
    vector c = cross(f, t);
    quat q(c.x, c.y, c.z, 1.0 + d);
    return quat_normalize(q);
}

point solver_spline_ik_joint_origin(joint_handle value) {
    WorldTransform world_data = WorldTransform(value);
    return world_data.xform * point(0.0, 0.0, 0.0);
}

matrix solver_spline_ik_local_matrix(joint_handle value) {
    Joint joint_data = Joint(value);
    quat rotation = quat_normalize(joint_data.rotation);
    float x = rotation.x;
    float y = rotation.y;
    float z = rotation.z;
    float w = rotation.w;
    float xx = x * x;
    float yy = y * y;
    float zz = z * z;
    float xy = x * y;
    float xz = x * z;
    float yz = y * z;
    float wx = w * x;
    float wy = w * y;
    float wz = w * z;
    float sx = joint_data.scale.x;
    float sy = joint_data.scale.y;
    float sz = joint_data.scale.z;
    return matrix(
        sx * (1.0 - 2.0 * (yy + zz)),
        sy * (2.0 * (xy - wz)),
        sz * (2.0 * (xz + wy)),
        joint_data.translation.x,
        sx * (2.0 * (xy + wz)),
        sy * (1.0 - 2.0 * (xx + zz)),
        sz * (2.0 * (yz - wx)),
        joint_data.translation.y,
        sx * (2.0 * (xz - wy)),
        sy * (2.0 * (yz + wx)),
        sz * (1.0 - 2.0 * (xx + yy)),
        joint_data.translation.z,
        0.0, 0.0, 0.0, 1.0);
}

matrix solver_spline_ik_parent_world(joint_handle value) {
    joint_handle parent = joint_parent(value);
    if (!handle_valid(parent)) {
        return mat_identity();
    }
    WorldTransform world_data = WorldTransform(value);
    return mat_mul(
        world_data.xform,
        mat_inverse(solver_spline_ik_local_matrix(value)));
}

export int solver_spline_ik [[
    string stage = "solver",
    string partial_propagation = "descendants"
]]
    (joint_handle root,
     joint_handle end,
     point spline[],
     int point_count) {
    if (!handle_valid(root) || !handle_valid(end)
        || point_count < 2
        || joint_is_ancestor(root, end) == 0)
    {
        return 0;
    }

    int chain_count = 1;
    joint_handle cursor = end;
    while (cursor != root
        && handle_valid(cursor)
        && chain_count < solver_context.joint_count)
    {
        cursor = joint_parent(cursor);
        chain_count = chain_count + 1;
    }
    if (cursor != root || chain_count < 2) {
        return 0;
    }

    int segment = chain_count - 2;
    joint_handle child = end;
    joint_handle pivot = joint_parent(child);
    while (segment >= 0 && handle_valid(pivot)) {
        float t0 = segment * 1.0 / (chain_count - 1);
        float t1 = (segment + 1) * 1.0 / (chain_count - 1);
        point curve_start =
            solver_spline_ik_sample(spline, point_count, t0);
        point curve_end =
            solver_spline_ik_sample(spline, point_count, t1);
        vector tangent = curve_end - curve_start;

        if (length(tangent) > 0.000001) {
            Joint child_data = Joint(child);
            Joint pivot_data = Joint(pivot);
            vector offset(
                child_data.translation.x,
                child_data.translation.y,
                child_data.translation.z);
            vector desired = tangent;
            joint_handle parent = joint_parent(pivot);
            if (handle_valid(parent)) {
                matrix parent_inverse =
                    mat_inverse(solver_spline_ik_parent_world(pivot));
                point local_start = parent_inverse * curve_start;
                point local_end = parent_inverse * curve_end;
                desired = local_end - local_start;
            }
            pivot_data.rotation =
                solver_spline_ik_quat_from_to(offset, desired);
        }

        child = pivot;
        if (pivot == root) {
            pivot = joint_handle_invalid();
        } else {
            pivot = joint_parent(pivot);
        }
        segment = segment - 1;
    }
    return 1;
}
