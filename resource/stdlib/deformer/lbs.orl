// Linear blend skinning.
//   use deformer/lbs;
//
// bind_positions are rest-pose vertices. inverse_binds[j] is the inverse of
// joint j's world matrix at bind time. weights[] is vertex-major
// Weight cells: weights[vertex * weight_cnt + slot].

use joint;
use weight;

int deformer_lbs_capture_bind(Joint joints[], matrix inverse_binds[], int joint_count) {
    int j = 0;
    while (j < joint_count) {
        matrix world = joint_world_matrix(joints, j);
        inverse_binds[j] = mat_inverse(world);
        j = j + 1;
    }
    return joint_count;
}

int deformer_lbs(point bind_positions[],
                 point output_positions[],
                 Joint joints[],
                 matrix inverse_binds[],
                 Weight weights[],
                 int vertex_count,
                 int joint_count,
                 int weight_cnt) {
    parallel for (int vertex = 0; vertex < vertex_count; vertex = vertex + 1) {
        point bind = bind_positions[vertex];
        point skinned(0.0, 0.0, 0.0);
        int i = 0;
        while (i < weight_cnt) {
            Weight cell = weights[vertex * weight_cnt + i];
            if (cell.joint >= 0) {
                matrix world = joint_world_matrix(joints, cell.joint);
                matrix skin = joint_skin_matrix(world, inverse_binds[cell.joint]);
                skinned = skinned + cell.weight * (skin * bind);
            }
            i = i + 1;
        }
        output_positions[vertex] = skinned;
    }
    return vertex_count;
}
