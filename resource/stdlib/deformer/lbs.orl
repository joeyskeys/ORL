// Linear blend skinning.
//   use deformer/lbs;
//
// bind_positions are rest-pose vertices. inverse_binds[j] is the inverse of
// joint j's world matrix at bind time. bone_indices[] / weights[] are packed
// as influences_per_vertex consecutive values per vertex.

use joint;

int deformer_lbs_capture_bind(Joint joints[], matrix inverse_binds[], int joint_count) {
    int j = 0;
    while (j < joint_count) {
        matrix world = joint_world_matrix(joints, j);
        inverse_binds[j] = mat_inverse(world);
        j = j + 1;
    }
    return joint_count;
}

int deformer_lbs(point bind_positions[],
                 point output_positions[],
                 Joint joints[],
                 matrix inverse_binds[],
                 int bone_indices[],
                 float weights[],
                 int vertex_count,
                 int joint_count,
                 int influences_per_vertex) {
    parallel for (int vertex = 0; vertex < vertex_count; vertex = vertex + 1) {
        point bind = bind_positions[vertex];
        point skinned(0.0, 0.0, 0.0);
        int i = 0;
        while (i < influences_per_vertex) {
            int slot = vertex * influences_per_vertex + i;
            int bone = bone_indices[slot];
            float w = weights[slot];
            if (bone >= 0) {
                matrix world = joint_world_matrix(joints, bone);
                matrix skin = joint_skin_matrix(world, inverse_binds[bone]);
                skinned = skinned + w * (skin * bind);
            }
            i = i + 1;
        }
        output_positions[vertex] = skinned;
    }
    return vertex_count;
}
