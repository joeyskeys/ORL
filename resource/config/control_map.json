{
  "version": 1,
  "bindings": [
    {
      "op": "toggle_grid",
      "scope": "panel",
      "panel": "viewport",
      "input": {
        "type": "key",
        "key": "G",
        "action": "press",
        "mods": ["shift"]
      }
    },
    {
      "op": "toggle_frame_axis",
      "scope": "panel",
      "panel": "viewport",
      "input": {
        "type": "key",
        "key": "F",
        "action": "press"
      }
    },
    {
      "op": "camera_orbit",
      "scope": "panel",
      "panel": "viewport",
      "input": {
        "type": "mouse_drag",
        "button": "middle"
      }
    },
    {
      "op": "camera_pan",
      "scope": "panel",
      "panel": "viewport",
      "input": {
        "type": "mouse_drag",
        "button": "middle",
        "mods": ["shift"]
      }
    },
    {
      "op": "camera_zoom",
      "scope": "panel",
      "panel": "viewport",
      "input": {
        "type": "scroll"
      }
    },
    {
      "op": "open_project",
      "scope": "window",
      "input": {
        "type": "key",
        "key": "O",
        "action": "press",
        "mods": ["ctrl"]
      }
    },
    {
      "op": "save_project",
      "scope": "window",
      "input": {
        "type": "key",
        "key": "S",
        "action": "press",
        "mods": ["ctrl"]
