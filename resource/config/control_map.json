      "scope": "panel",
      "panel": "viewport",
      "input": {
        "type": "key",
        "key": "kp1",
        "action": "press"
      }
    },
    {
      "op": "camera_switch",
      "scope": "panel",
      "panel": "viewport",
      "input": {
        "type": "key",
        "key": "kp3",
        "action": "press"
      }
    },
