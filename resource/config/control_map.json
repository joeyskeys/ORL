      "scope": "window",
      "input": {
        "type": "key",
        "key": "I",
        "action": "press",
        "mods": ["ctrl"]
      }
    },
    {
      "op": "clear_scene",
      "scope": "window",
      "input": {
        "type": "key",
        "key": "N",
        "action": "press",
        "mods": ["ctrl"]
