// Linear blend skinning with Weight cells.
//
// input_positions and output_positions are point buffers.
// bone_matrices contains row-major affine 4x4 transforms.
// weights is vertex-major: weights[vertex * weight_cnt + slot].
use weight;

int deform(point input_positions[],
           point output_positions[],
           matrix bone_matrices[],
           Weight weights[],
           int vertex_count,
           int weight_cnt) {
    parallel for (int vertex = 0; vertex < vertex_count; vertex = vertex + 1) {
        point bind_position = input_positions[vertex];
        point skinned(0.0, 0.0, 0.0);
        int i = 0;
        while (i < weight_cnt) {
            Weight cell = weights[vertex * weight_cnt + i];
            if (cell.joint >= 0) {
                skinned = skinned + cell.weight * (bone_matrices[cell.joint] * bind_position);
            }
            i = i + 1;
        }
        output_positions[vertex] = skinned;
    }

    return vertex_count;
}
