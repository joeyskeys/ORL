// Linear blend skinning with two influences per vertex.
//
// input_positions and output_positions are point buffers.
// bone_matrices contains row-major affine 4x4 transforms.
// weights and bone_indices are packed as two consecutive values per vertex.
int deform(point input_positions[],
           point output_positions[],
           matrix bone_matrices[],
           float weights[],
           int bone_indices[],
           int vertex_count) {
    int vertex = 0;
    while (vertex < vertex_count) {
        int influence = vertex * 2;
        int bone0 = bone_indices[influence];
        int bone1 = bone_indices[influence + 1];
        float weight0 = weights[influence];
        float weight1 = weights[influence + 1];

        point bind_position = input_positions[vertex];
        point transformed0 = bone_matrices[bone0] * bind_position;
        point transformed1 = bone_matrices[bone1] * bind_position;
        output_positions[vertex] = weight0 * transformed0 + weight1 * transformed1;

        vertex = vertex + 1;
    }
    return vertex_count;
}
